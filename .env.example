# Copy to .env and fill in. .env is never committed.

# --- Postgres (Docker, local only — NEVER RDS per CLAUDE.md) ---
# Use 127.0.0.1 (IPv4), not localhost — Node prefers IPv6 and the Docker IPv6 mapping is flaky.
DATABASE_URL=postgresql://rbi:rbi@127.0.0.1:5433/rbi

# --- Ollama (local models) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_EXTRACT=gemma3:4b
OLLAMA_MODEL_PARSE=qwen3:8b
OLLAMA_NUM_CTX=4096

# --- LLM cost control (this code enforces the cap; AWS will not) ---
MAX_SPEND_USD=15.00
LLM_CACHE_PATH=data/llm_cache.db

# --- Bedrock (verifier agent — the ONLY paid inference step) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_ESCALATION_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# Per-token rates live in a config file, not hardcoded — see src/rbi/llm/pricing.json
BEDROCK_PRICING_PATH=src/rbi/llm/pricing.json

# --- Fetch (be a good citizen — see CLAUDE.md 6.1) ---
RBI_USER_AGENT=rbi-timeline-research/0.1 (portfolio project; contact shreyas.naik0805@gmail.com)
FETCH_DELAY_SECONDS=2
